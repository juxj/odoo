<odoo>
  <record id="view_res_partner_level_tree" model="ir.ui.view">
    <field name="name">res.partner.level.tree</field>
    <field name="model">res.partner.level</field>
    <field name="arch" type="xml">
      <list>
        <field name="code"/>
        <field name="name"/>
        <field name="comments"/>
      </list>
    </field>
  </record>

  <record id="view_res_partner_level_form" model="ir.ui.view">
    <field name="name">res.partner.level.form</field>
    <field name="model">res.partner.level</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="code"/>
            <field name="name"/>
            <field name="comments"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_res_partner_level" model="ir.actions.act_window">
    <field name="name">用户等级</field>
    <field name="res_model">res.partner.level</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_partner_level_root"
            name="用户等级"
            parent="base.menu_custom" sequence="35"
            action="action_res_partner_level"/>
</odoo>
